MONGODB_URI=mongodb://127.0.0.1:27017/optictopus
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PORT=5000
PUBLIC_URL=http://localhost:5000
NODE_ENV=development
# Set to 1 only behind one trusted reverse proxy.
TRUST_PROXY=0
# Only enable when your origin accepts traffic exclusively from Cloudflare.
TRUST_CLOUDFLARE=0
# Optional new/recovery account for npm run admin:
# ADMIN_USERNAME=your-admin-name
# ADMIN_PASSWORD=your-new-password

# Durable image storage for Vercel (3 MiB maximum per new upload)
UPLOAD_STORAGE=mongodb
